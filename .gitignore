# ── 数据缓存与中间产物（可重新生成，不入库）────────────────────────
# （gitignore 不支持行尾注释，说明一律独立成行）
# 00_state: LLM 调用缓存，重跑管线可再生成
# 01_raw:   原始会话副本，由 stage1 从 pi sessions 提取
# 02_gold:  黄金提纯中间产物，由 stage2 从 01_raw 生成
data/00_state/
data/01_raw/
data/02_gold/

# ── 训练数据文件（体积大，由 stage3 重新生成）───────────────────────
data/03_train/*.jsonl
data/03_train/logs/
data/03_train/*.log
data/03_train/delivery/

# ── 训练产物 ──────────────────────────────────────────────────────
output/
dist/

# ── 发布包（由 tools/pack_27b.sh 生成，不入库）──────────────────────
*.tar.gz

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 环境与密钥 ────────────────────────────────────────────────────
.env
.env.*

# ── 编辑器 / 系统 ──────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db