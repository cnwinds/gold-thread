data/03_train/logs/
data/03_train/*.log
data/03_train/delivery/
data/03_train/candidates/
data/03_train/exports/
data/03_train/releases/
data/03_train/*.orig.*

# ── 训练产物 ──────────────────────────────────────────────────────
output/
dist/

# ── 发布包（由 tools/pack_27b.sh 生成，不入库）──────────────────────
*.tar.gz

# ── Python ────────────────────────────────────────────────────────
